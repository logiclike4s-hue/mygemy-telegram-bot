# Telegram bot token received from @BotFather
TELEGRAM_BOT_TOKEN=

# API keys for LLM providers
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI ChatGPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional settings
GEMINI_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat
CLAUDE_MODEL=claude-3-5-haiku-latest
DEFAULT_PROVIDER=gemini
HISTORY_LIMIT=20

# Render webhook mode. Leave empty for local polling mode.
RENDER_EXTERNAL_URL=
WEBHOOK_SECRET=

# On Railway this file is ephemeral. Set this to a mounted Volume path
# (for example: /data/bot_memory.sqlite3) if you want to retain chat history.
MEMORY_DB_PATH=bot_memory.sqlite3

# Separate Telegram admin bot
ADMIN_BOT_TOKEN=
ADMIN_USER_ID=
ADMIN_PASSWORD=

# USD per 1 million tokens; set prices for your Gemini model
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
