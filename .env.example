# Telegram bot token received from @BotFather
TELEGRAM_BOT_TOKEN=

# API key created in Google AI Studio
GEMINI_API_KEY=

# Optional settings
GEMINI_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-3.1-flash-image
HISTORY_LIMIT=20

# On Railway this file is ephemeral. Set this to a mounted Volume path
# (for example: /data/bot_memory.sqlite3) if you want to retain chat history.
MEMORY_DB_PATH=bot_memory.sqlite3
